GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Spotifish backend base URL. Must end with a trailing slash.
# Local Android emulator -> http://10.0.2.2:8080/
# Physical device on the same Wi-Fi -> http://<your-machine-ip>:8080/
# Production -> https://spotifish.example.com/
SPOTIFISH_BASE_URL=http://10.0.2.2:8080/
